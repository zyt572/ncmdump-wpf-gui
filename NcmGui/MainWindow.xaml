<Window x:Class="NcmGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NCM 转换台"
        Width="920" Height="864" MinWidth="800" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" Padding="0">
    <Grid Margin="30,26,30,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================================================== 顶栏 -->
        <Grid Grid.Row="0" MaxWidth="900" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource Ink}"
                    VerticalAlignment="Center">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Data="M4,14 L4,10 M8,18 L8,6 M12,15 L12,9 M16,20 L16,4 M20,14 L20,10"
                              Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="NCM 转换台" Style="{StaticResource H1}" />
                <TextBlock Text="网易云音乐加密文件 · 解密导出为 MP3 / FLAC" Style="{StaticResource Lede}" />
            </StackPanel>

            <Border Grid.Column="2" Height="26" Padding="10,0" CornerRadius="13"
                    Background="White" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Ok}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource Err}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding BinaryLabel}" Margin="6,0,0,0" FontSize="12"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================================================== 主卡片 -->
        <Border Grid.Row="1" MaxWidth="900" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 拖放区 -->
                <Grid Grid.Row="0" Margin="18" MinHeight="152">
                    <Rectangle x:Name="DropRect" RadiusX="13" RadiusY="13"
                               Fill="#FCFCFD" Stroke="#DFE3E9" StrokeThickness="1.5" StrokeDashArray="4 3" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,18">
                        <Grid Width="42" Height="42" HorizontalAlignment="Center">
                            <Ellipse Fill="#F3F5F8" />
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12,3 L12,14 M7.5,9.5 L12,14 L16.5,9.5 M4,16 L4,19 A1.5,1.5 0 0 0 5.5,20.5 L18.5,20.5 A1.5,1.5 0 0 0 20,19 L20,16"
                                          Stroke="#98A0AC" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <TextBlock Text="把 .ncm 文件拖到这里" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource Ink2}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="也可以从本机选择文件夹，文件始终留在本地" FontSize="12.5"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,3,0,0" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Button x:Name="PickFilesBtn" Content="选择文件" Style="{StaticResource GhostButton}"
                                    Click="PickFiles_Click" IsEnabled="{Binding CanPick}" />
                            <Button Content="选择文件夹" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Click="PickFolder_Click" IsEnabled="{Binding CanPick}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{StaticResource Line}" />

                <!-- 列表头 -->
                <Grid Grid.Row="2" Margin="20,15,20,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="文件" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Ink2}" VerticalAlignment="Center" />
                        <Border Background="#F1F3F6" CornerRadius="10" Padding="7,1" Margin="6,0,0,0">
                            <TextBlock Text="{Binding Files.Count}" FontSize="11.5"
                                       Foreground="#5D6470" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalSizeText}" FontSize="12.5"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Button Content="清空" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                Click="Clear_Click" IsEnabled="{Binding CanPick}"
                                Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>

                <!-- 列表 -->
                <Grid Grid.Row="3">
                    <StackPanel MinHeight="116" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="还没有添加文件" FontSize="13.5" Foreground="#9AA1AD"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="添加后逐条显示转换结果" FontSize="12.5" Foreground="{StaticResource Muted2}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Files}" Style="{StaticResource FileList}" MaxHeight="320"
                             Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Style="{StaticResource StatusDot}" />

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                   Foreground="{StaticResource Ink}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ToolTipText}"
                                                   MouseLeftButtonUp="Reveal_Click">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanReveal}" Value="True">
                                                            <Setter Property="Cursor" Value="Hand" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Foreground" Value="#C0353B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Message}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12"
                                               Foreground="{StaticResource Muted}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" TextAlignment="Right" />

                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                               Style="{StaticResource StatusLabel}" />

                                    <Button Grid.Column="4" Content="×" Click="Remove_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowRemoveButton}">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                 Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Row="4" Height="1" Background="{StaticResource Line}" />

                <!-- 设置 -->
                <StackPanel Grid.Row="5" Margin="20,14,20,16">
                    <TextBlock Text="输出目录" Style="{StaticResource SectionLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <TextBox x:Name="OutDirBox" Style="{StaticResource Field}"
                                     Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="默认与原文件放在一起" FontSize="13" IsHitTestVisible="False"
                                       Foreground="{StaticResource Placeholder}" Margin="12,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=OutDirBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="1" Content="浏览" Style="{StaticResource SmallGhostButton}"
                                Margin="8,0,0,0" Click="PickOutput_Click" IsEnabled="{Binding CanPick}" />
                        <Button Grid.Column="2" Content="清除"
                                Margin="8,0,0,0" Click="ClearOutput_Click" IsEnabled="{Binding CanPick}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SmallGhostButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=OutDirBox}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid Margin="0,11,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="删除原文件" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Ink2}" />
                            <TextBlock Text="转换成功后移除对应的 .ncm" FontSize="12" Foreground="{StaticResource Muted2}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding RemoveSource}" IsEnabled="{Binding CanPick}" />
                    </Grid>

                    <Grid Margin="0,11,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="包含子文件夹" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Ink2}" />
                            <TextBlock Text="选择文件夹时递归查找" FontSize="12" Foreground="{StaticResource Muted2}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      IsChecked="{Binding Recursive}" IsEnabled="{Binding CanPick}" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="6" Height="1" Background="{StaticResource Line}" />

                <!-- 底部操作 -->
                <Grid Grid.Row="7" Margin="20,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="#6D7480"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,9" />
                        <ProgressBar Style="{StaticResource ThinProgress}" Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="取消" Style="{StaticResource LinkButton}" Margin="0,0,14,0"
                                Click="Cancel_Click"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                        <Button Content="打开输出文件夹" Style="{StaticResource GhostButton}" Margin="0,0,14,0"
                                Click="OpenOutput_Click"
                                Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}" />
                        <Button x:Name="StartBtn" Content="开始转换" Style="{StaticResource PrimaryButton}"
                                Click="Start_Click" IsEnabled="{Binding CanStart}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================================================== 日志 -->
        <Border Grid.Row="2" MaxWidth="900" Margin="0,14,0,0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="16,0">
            <StackPanel>
                <Button x:Name="LogToggle" Style="{StaticResource LogHeaderButton}" Click="LogToggle_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="LogChev" Text="›" FontSize="15" Foreground="{StaticResource Muted2}"
                                   Margin="0,0,7,0" VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="LogChevRotate" Angle="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="运行日志" FontSize="12.5" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LogCountText}" FontSize="11.5" Foreground="{StaticResource Muted2}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBox x:Name="LogBox" Visibility="Collapsed" Height="170" IsReadOnly="True"
                         Background="Transparent" BorderThickness="0" Padding="0,0,0,12"
                         FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="11.5"
                         Foreground="#5D6470" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         IsReadOnlyCaretVisible="False" FocusVisualStyle="{x:Null}" />
            </StackPanel>
        </Border>

        <!-- ==================================================== 脚注 -->
        <TextBlock Grid.Row="3" Text="由同目录的 ncmdump.exe 完成解密 · 所有处理都在本机完成"
                   FontSize="11.5" Foreground="#A8AEB9" HorizontalAlignment="Center" Margin="0,14,0,0" />
    </Grid>
    </ScrollViewer>
</Window>
